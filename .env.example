# Copier ce fichier en .env et remplir les valeurs (le fichier .env n'est jamais versionné).
# Code demandé pour ouvrir l'application (laisser vide = pas de code, à éviter en ligne).
ACCESS_CODE=
# Secret partagé avec le réveil GitHub Actions (POST /api/cron/tick).
CRON_SECRET=
# Serveur ntfy (par défaut le service public gratuit).
NTFY_SERVER=https://ntfy.sh
# Lien ouvert quand on touche la notification (adresse publique de l'app).
APP_URL=
# Port du serveur.
PORT=5000
